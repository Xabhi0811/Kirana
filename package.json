{
  "name": "kirana",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "playwright test tests/browser/marketplace.spec.ts --project=desktop",
    "test:browser": "playwright test tests/browser/smoke.spec.ts",
    "test:demo": "playwright test tests/browser/demo.spec.ts --project=desktop",
    "format": "prettier --write src database/scripts tests *.ts *.mjs *.json",
    "seed": "tsx database/scripts/seed.ts",
    "seed:demo": "tsx database/scripts/demo-data.ts",
    "test:security": "playwright test tests/browser/security.spec.ts --project=desktop",
    "db:inspect": "tsx database/scripts/database.ts --inspect",
    "db:check": "tsx database/scripts/check-supabase.ts",
    "local:db:setup": "tsx database/scripts/local-postgres.ts setup",
    "local:db:start": "tsx database/scripts/local-postgres.ts start",
    "local:db:stop": "tsx database/scripts/local-postgres.ts stop",
    "local:db:status": "tsx database/scripts/local-postgres.ts status",
    "db:migrate": "tsx database/scripts/database.ts --apply",
    "db:start": "supabase --workdir database start",
    "db:reset": "supabase --workdir database db reset"
  },
  "dependencies": {
    "@googlemaps/js-api-loader": "^2.0.2",
    "@hookform/resolvers": "^5.2.0",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-slot": "^1.1.2",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.90.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.62.0",
    "sharp": "^0.35.4",
    "tailwind-merge": "^3.0.0",
    "zod": "^4.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "pg": "^8.23.0",
    "prettier": "^3.9.6",
    "supabase": "^2.75.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.7.0"
  }
}

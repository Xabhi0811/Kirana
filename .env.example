NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Public browser key restricted to Kirana web referrers and Maps JavaScript/Places APIs.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_PLACES_ENABLED=false
# Server-only legacy seeder and registration integration key. Never use NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=
SEED_PASSWORD=
# Optional server-only migration connection (session pooler, port 5432).
# Percent-encode special characters in the password. Never use NEXT_PUBLIC.
DIRECT_URL=
# Download the server root certificate from Supabase Database Settings.
SUPABASE_DB_CA_FILE=
# Optional hosted registration integration opt-in; never target production.
RUN_REMOTE_TESTS=false
# Optional installed browser path for Playwright.
PLAYWRIGHT_EXECUTABLE_PATH=
